{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --watch=src/,public/ src/main.ts",
    "test": "deno test --allow-net --allow-env --allow-read tests/integration_test.ts",
    "test:staging": "deno test --allow-net --allow-env --allow-read tests/staging_test.ts",
    "check:parity": "deno test --allow-net --allow-env --allow-read tests/staging_test.ts",
    "emulator": "deno run --allow-net --allow-env --allow-read examples/device_emulator.ts",
    "db:push": "supabase db push",
    "uprev": "deno run --allow-read --allow-write scripts/uprev.ts",
    "deploy": "deployctl deploy --project=marveluzz-hub --entrypoint=src/main.ts",
    "deploy:all": "deno task test && deno task db:push && deno task deploy"
  },
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.39.0"
  }
}
