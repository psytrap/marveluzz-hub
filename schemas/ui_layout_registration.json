{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://marveluzz-hub.internal/schemas/ui_layout_registration.json",
  "title": "Dynamic UI Layout Registration Schema",
  "description": "JSON Schema for register_ui_definition RPC payload uploaded by IoT nodes.",
  "type": "object",
  "required": ["p_device_id", "p_device_key", "p_layout_def"],
  "properties": {
    "p_device_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique UUID identifier of the IoT device."
    },
    "p_device_key": {
      "type": "string",
      "minLength": 1,
      "description": "Secret authentication key flased into the IoT device."
    },
    "p_layout_def": {
      "type": "object",
      "required": ["title", "type", "layout"],
      "properties": {
        "title": {
          "type": "string",
          "description": "Display header title for the device panel."
        },
        "type": {
          "type": "string",
          "enum": ["layout"]
        },
        "properties": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "flow": { "type": "string", "enum": ["row", "column"] },
            "fast_timeout": { "type": "integer", "description": "Active Fast Mode stream interval/timeout in milliseconds (default 5000ms)." },
            "slow_timeout": { "type": "integer", "description": "Power-Save Idle Mode stream interval/timeout in milliseconds (default 30000ms)." }
          }
        },
        "layout": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "properties"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["number", "indicator", "range", "button", "text", "img", "divider", "chart"]
              },
              "properties": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "label": { "type": "string" },
                  "id": { "type": "string" },
                  "value": { "type": ["string", "number", "boolean"] },
                  "unit": { "type": "string" },
                  "min": { "type": ["string", "number"] },
                  "max": { "type": ["string", "number"] },
                  "readonly": { "type": ["string", "boolean"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
