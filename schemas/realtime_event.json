{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://marveluzz-hub.internal/schemas/realtime_event.json",
  "title": "Supabase Realtime WebSocket Event Schema",
  "description": "JSON Schema for postgres_changes command push events received by IoT nodes over WebSockets.",
  "type": "object",
  "required": ["event", "topic", "payload"],
  "properties": {
    "event": {
      "type": "string",
      "enum": ["postgres_changes"]
    },
    "topic": {
      "type": "string",
      "description": "Phoenix WebSocket topic string (realtime:public:device_commands:device_id=eq.<uuid>)."
    },
    "payload": {
      "type": "object",
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "required": ["record"],
          "properties": {
            "record": {
              "type": "object",
              "required": ["id", "device_id", "target", "action", "status"],
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "device_id": { "type": "string", "format": "uuid" },
                "target": { "type": "string" },
                "action": { "type": "string" },
                "value": {},
                "status": { "type": "string" },
                "created_at": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
