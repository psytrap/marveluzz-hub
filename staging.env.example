# Marveluzz Hub - Environment Variable Template
# Copy this file to staging.env or .env to configure your server environment

# -------------------------------------------------------------
# 🌐 Target Deployment & Network Settings
# -------------------------------------------------------------
# Live or local staging target URL for parity testing (deno task test:staging)
STAGING_URL=http://localhost:8000

# -------------------------------------------------------------
# ⚡ Supabase Cloud Production Database Credentials
# -------------------------------------------------------------
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# -------------------------------------------------------------
# 🔒 GitHub OAuth & Access Control Settings
# -------------------------------------------------------------
# Set to "true" to bypass login for local use, or "false" to enforce authentication
DISABLE_AUTH=false

# GitHub OAuth App Credentials (from GitHub Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Comma-separated list of permitted GitHub usernames allowed to access dashboard
ALLOWED_GITHUB_USERS=alice,bob,your_github_username
