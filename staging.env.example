# Marveluzz Hub - Environment Variable Template
# Copy this file to staging.env and fill in your values (staging.env is git-ignored)

# -------------------------------------------------------------
# 🌐 Target Deployment & Network Settings
# -------------------------------------------------------------
DENO_STAGING_URL=https://<your-deno-deploy-project>.deno.dev
SUPABASE_STAGING_URL=https://<project-id>.supabase.co

# -------------------------------------------------------------
# 🤖 IoT Device Emulator Panel Settings (examples/device_emulator.ts)
# -------------------------------------------------------------
EMULATOR_URL=https://<project-id>.supabase.co
EMULATOR_PORT=8001
EMULATOR_DEVICE_ID=<your-device-uuid>
EMULATOR_DEVICE_KEY=<your-device-secret-key>
EMULATOR_ANON_KEY=<your-supabase-anon-key>

# -------------------------------------------------------------
# ⚡ Supabase Cloud Production Database Credentials
# -------------------------------------------------------------
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>

# -------------------------------------------------------------
# 🔒 GitHub OAuth & Access Control Settings
# -------------------------------------------------------------
# Set to "true" to bypass login for local use, or "false" to enforce authentication
DISABLE_AUTH=false

# GitHub OAuth App Credentials (from GitHub Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID=<your-github-client-id>
GITHUB_CLIENT_SECRET=<your-github-client-secret>

# Comma-separated list of permitted GitHub usernames allowed to access dashboard
ALLOWED_GITHUB_USERS=<your-github-username>
